{
  "extends": [
    "stylelint-config-standard"
  ],
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "theme",
          "custom-variant",
          "utility",
          "variant",
          "apply",
          "source",
          "plugin",
          "reference",
          "config"
        ]
      }
    ],
    "at-rule-no-deprecated": [
      true,
      {
        "ignoreAtRules": [
          "apply"
        ]
      }
    ],
    "import-notation": "string",
    "custom-property-pattern": null,
    "function-no-unknown": [
      true,
      {
        "ignoreFunctions": [
          "theme",
          "--alpha",
          "--spacing"
        ]
      }
    ],
    "nesting-selector-no-missing-scoping-root": [
      true,
      {
        "ignoreAtRules": [
          "custom-variant"
        ]
      }
    ],
    "at-rule-prelude-no-invalid": [
      true,
      {
        "ignoreAtRules": [
          "theme",
          "custom-variant",
          "utility",
          "variant",
          "apply",
          "source",
          "plugin",
          "reference",
          "config"
        ]
      }
    ],
    "lightness-notation": "number",
    "hue-degree-notation": "number"
  }
}
